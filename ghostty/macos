# macOS only. Loaded after ghostty/config from the ~/.config/ghostty/config.ghostty
# wrapper that setup.sh writes. Linux and Windows use Alt instead of Cmd: see keys-alt.
font-size = 12
font-thicken = true
adjust-cell-width = 0
macos-titlebar-style = tabs

# Tab navigation
keybind = cmd+arrow_left=previous_tab
keybind = cmd+arrow_right=next_tab

# Tmux window switching (prefix = Ctrl+B = \x02)
keybind = cmd+n=text:\x02n
keybind = cmd+p=text:\x02p

# Match the standard macOS shortcut for reset font size.
keybind = cmd+0=reset_font_size
