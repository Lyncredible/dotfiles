# Shared by every OS. Per-OS settings live next to this file and are loaded after it:
#   macOS, Linux: ghostty/macos or ghostty/linux, via ~/.config/ghostty/config.ghostty
#   Windows:      ghostty/windows, via %LOCALAPPDATA%\ghostty\config.ghostty
# setup.sh and setup.ps1 write those wrappers. Linux and Windows share keys-alt.
cursor-click-to-move = true
cursor-style = block
font-family = JetBrains Mono
shell-integration-features = no-cursor,ssh-terminfo
theme = Dimmed Monokai
window-width = 160
window-height = 40

# Bells
bell-features = no-audio

# Quick terminal
keybind = ctrl+grave_accent=toggle_quick_terminal

# Ctrl+J newline (not sent natively without tmux)
keybind = ctrl+j=text:\n
