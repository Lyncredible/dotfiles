# Shared by every OS. Per-OS settings live next to this file and are loaded after it:
#   macOS, Linux: ghostty/unix, via the ~/.config/ghostty/config.ghostty setup.sh writes
#   Windows:      ghostty/windows, via the %LOCALAPPDATA%\ghostty\config.ghostty setup.ps1 writes
cursor-click-to-move = true
cursor-style = block
shell-integration-features = ssh-terminfo
theme = Dimmed Monokai

# Bells
bell-features = no-audio

# Quick terminal
keybind = ctrl+grave_accent=toggle_quick_terminal

# Ctrl+J newline (not sent natively without tmux)
keybind = ctrl+j=text:\n
