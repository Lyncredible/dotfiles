# Windows only. Loaded after ghostty/config from the %LOCALAPPDATA%\ghostty\config.ghostty
# wrapper that setup.ps1 writes. Cmd shortcuts from ghostty/macos use Alt here.
command = wsl.exe
window-width = 160
window-height = 40
window-save-state = always

# Tab navigation
keybind = alt+arrow_left=previous_tab
keybind = alt+arrow_right=next_tab

# Tmux window switching (prefix = Ctrl+B = \x02)
keybind = alt+n=text:\x02n
keybind = alt+p=text:\x02p
keybind = alt+1=text:\x021
keybind = alt+2=text:\x022
keybind = alt+3=text:\x023
keybind = alt+4=text:\x024
keybind = alt+5=text:\x025
keybind = alt+6=text:\x026
keybind = alt+7=text:\x027
keybind = alt+8=text:\x028
keybind = alt+9=text:\x029

# Reset font size, like Cmd+0 on macOS.
keybind = alt+0=reset_font_size
