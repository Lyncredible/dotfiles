[user]
	name = Yuan Liu
	email = lyncredible@outlook.com
[rerere]
	enabled = true
[pull]
	rebase = true
[push]
	default = current
[fetch]
	prune = true
[core]
    pager =
	preloadindex = true
	# Git for Windows rejects anything above 2g ("bad numeric config value ... out of range").
	deltabasecachelimit = 2g
[pager]
	log = less
	diff = less
[help]
	autocorrect = 50
