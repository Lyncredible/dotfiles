# PowerShell versions live in powershell/aliases.ps1. Keep the two in sync.
alias venv='uv venv'
alias act='source .venv/bin/activate'
alias dact='deactivate'
alias aup='antigen selfupdate && antigen update && chmod -R g-w ~/.antigen'
alias grpo='git remote prune origin'
# Delete merged branches, except the current one, ones checked out in worktrees, and
# master, main, and dev.
alias gbdm="git branch --merged | grep -vE '^[*+]|^ *(master|main|dev)\$' | xargs -r git branch -d"